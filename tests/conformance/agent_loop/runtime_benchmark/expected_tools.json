  {
    "type": "function",
    "function": {
      "name": "bash",
      "description": "Run one non-interactive /bin/bash command inside the workspace. Provide description before command: a concise explanation of why you are running it, shown in the UI. No shell state survives between calls. The optional timeout is in seconds. A background execution immediately returns its live output file's absolute path; use Read or Grep on it to inspect the output while the command runs.\n\nPass business tool inputs inside the required arguments object. Runtime permission metadata belongs outside arguments.\n\nExecution ownership: every call to this tool must include the top-level \"execution_mode\" field, set to \"foreground\" when the agent needs this call's terminal result before it can continue, or \"background\" when the work should keep running independently while the agent proceeds.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "urn:rustx:invocation",
        "type": "object",
        "definitions": {
          "json-schema:///": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "definitions": {
              "schema0": {
                "allOf": [
                  {
                    "$ref": "json-schema:///#/x-rustx-schema-nodes/schema0"
                  }
                ]
              },
              "schema1": {
                "allOf": [
                  {
                    "$ref": "json-schema:///#/x-rustx-schema-nodes/schema1"
                  }
                ]
              },
              "schema2": {
                "allOf": [
                  {
                    "$ref": "json-schema:///#/x-rustx-schema-nodes/schema2"
                  }
                ]
              },
              "schema3": {
                "allOf": [
                  {
                    "$ref": "json-schema:///#/x-rustx-schema-nodes/schema3"
                  }
                ]
              }
            },
            "x-rustx-schema-nodes": {
              "schema0": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "$ref": "json-schema:///#/definitions/schema1"
                  },
                  "description": {
                    "$ref": "json-schema:///#/definitions/schema2"
                  },
                  "timeout": {
                    "$ref": "json-schema:///#/definitions/schema3"
                  }
                },
                "required": [
                  "command"
                ]
              },
              "schema1": {
                "type": "string",
                "description": "The command handed to one `/bin/bash -c` invocation.",
                "minLength": 1
              },
              "schema2": {
                "type": "string",
                "description": "A concise, active-voice explanation of why this command is being run,\nshown beside Bash in the UI. Supply description before command, e.g.\n\"Check installed spreadsheet libraries\" or \"Run the UI regression tests\".\nOne to 160 Unicode scalar values; whitespace-only values are rejected.\nPresentation only, never execution or approval authority.",
                "minLength": 1,
                "maxLength": 160
              },
              "schema3": {
                "type": "integer",
                "format": "uint64",
                "minimum": 1,
                "description": "The invocation deadline in seconds. When omitted, no executor-local\ndeadline applies: a foreground invocation is bounded by the generic\nAgent Loop execution-liveness hard deadline (Issue #204), and a\nbackground execution is conversation-owned and unbounded."
              }
            },
            "allOf": [
              {
                "$ref": "json-schema:///#/definitions/schema0"
              }
            ],
            "$id": "json-schema:///"
          }
        },
        "properties": {
          "arguments": {
            "$ref": "json-schema:///"
          },
          "elevation_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512,
            "description": "Optional reason requesting human escalation for this exact tool call under Plan or Automatic permission modes. Omit or leave null when no escalation is requested. At most 512 UTF-8 bytes when present. This is a reason only — never approval evidence — and it never reaches the tool's business executor."
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "foreground",
              "background"
            ],
            "description": "Required execution ownership for this tool call. Use \"foreground\" when the agent needs this invocation to complete and return its terminal result before continuing. Use \"background\" when the work should keep running independently while the agent proceeds with other work. Decide by whether your next step depends on this call's terminal result, not by how long the work is expected to take."
          }
        },
        "required": [
          "arguments",
          "execution_mode"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "todo",
      "description": "Track multi-step work as a visible task list the user can see. Open a list before starting anything that takes several steps, and keep it current as you work: create one task per discrete step, mark exactly one task in_progress at a time, and mark a task completed immediately when it is done rather than in batches at the end. Never complete a task whose tests fail or whose work is unfinished — leave it in_progress and add a task for the remaining work. Change a task's status with {\"action\": \"update\", \"id\": N, \"status\": \"...\"}. Use blocked_by/add_blocked_by when one task genuinely cannot start before another finishes. Skip the list entirely for single-step work — it is overhead there. Every reply contains the complete list, so a list action is only needed to re-read it.\n\nPass business tool inputs inside the required arguments object. Runtime permission metadata belongs outside arguments.",
