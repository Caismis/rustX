{
  "description": "A schema rename must preserve a downstream read of an open object",
  "block": {
    "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "start": {
        "type": "start"
      },
      "collect": {
        "type": "loop",
        "input": {
          "type": "literal",
          "value": {}
        },
        "body": {
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "output": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string"
              }
            },
            "required": [
              "before"
            ],
            "additionalProperties": true
          },
          "nodes": {
            "start": {
              "type": "start"
            },
            "done": {
              "type": "return",
              "output": {
                "type": "object",
                "fields": {
                  "before": {
                    "type": "literal",
                    "value": "wanted"
                  },
                  "after": {
                    "type": "literal",
                    "value": "unrelated"
                  }
                }
              }
            }
          },
          "edges": [
            {
              "from": "start",
              "to": "done"
            }
          ]
        },
        "until": {
          "type": "boolean",
          "value": {
            "type": "literal",
            "value": true
          }
        },
        "carry": {
          "type": "literal",
          "value": {}
        },
        "max_iterations": 1
      },
      "done": {
        "type": "return",
        "output": {
          "type": "object",
          "fields": {
            "value": {
              "type": "reference",
              "path": [
                "collect",
                "result",
                "before"
              ]
            }
          }
        }
      }
    },
    "edges": [
      {
        "from": "start",
        "to": "collect"
      },
      {
        "from": "collect",
        "to": "done",
        "port": "satisfied"
      },
      {
        "from": "collect",
        "to": "done",
        "port": "exhausted"
      }
    ]
  }
}
