{
  "name": "@rustx/app-server-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "generate": "cargo run --manifest-path ../../Cargo.toml --example generate_app_server_protocol && node generate.mjs",
    "check": "pnpm generate && git diff --exit-code -- v7.schema.json v7.ts fixtures.json fixtures.ts",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module nodenext --target es2022 fixtures.ts type-contracts.ts"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3"
  }
}
