{
  "$defs": {
    "WorkflowAgentOutput": {
      "description": "The authored output contract of a Workflow Agent node, as Dify's Agent:\nthe final reply is the `text` variable, or a declared schema adds the\nreserved `workflow_output` terminal and its fields are the variables.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The child's final reply is the result.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The child commits one value matching this schema.",
          "properties": {
            "schema": true,
            "type": {
              "const": "json_schema",
              "type": "string"
            }
          },
          "required": [
            "type",
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowBlock": {
      "additionalProperties": false,
      "description": "A fixed lexical graph shared by the root and Loop bodies.",
      "properties": {
        "edges": {
          "default": [],
          "description": "Ordinary sequential control-flow edges.",
          "items": {
            "$ref": "#/$defs/WorkflowEdgeDefinition"
          },
          "type": "array"
        },
        "input": {
          "description": "The workflow input JSON Schema."
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowNodeDefinition"
          },
          "description": "Stable node definitions keyed by explicit node id.",
          "type": "object"
        },
        "output": {
          "description": "The workflow output JSON Schema."
        }
      },
      "required": [
        "input",
        "output",
        "nodes"
      ],
      "type": "object"
    },
    "WorkflowBlockStep": {
      "additionalProperties": false,
      "description": "Structured lexical address of a Loop body.",
      "properties": {
        "node": {
          "type": "string"
        }
      },
      "required": [
        "node"
      ],
      "type": "object"
    },
    "WorkflowBranchCase": {
      "additionalProperties": false,
      "description": "A stable exit identity and its condition. The first matching case wins.",
      "properties": {
        "condition": {
          "$ref": "#/$defs/WorkflowPredicate"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "condition"
      ],
      "type": "object"
    },
    "WorkflowDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "WorkflowDisplay": {
      "additionalProperties": false,
      "description": "How people see the Workflow in the library and editor. Never part of the\nprogram: models only read the definition's own `description`.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "description": "An Iconify icon name, `<prefix>:<name>` (e.g. `lucide:workflow`).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "The human name; the file id remains the native identity.",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "WorkflowEdgeDefinition": {
      "additionalProperties": false,
      "description": "One explicit edge in the workflow graph.",
      "properties": {
        "from": {
          "description": "Source node id.",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowPort"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required Branch/Loop outcome port. Ordinary nodes must omit it."
        },
        "to": {
          "description": "Destination node id.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "WorkflowEditorMetadata": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowDisplay"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowNodePresentation"
          },
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowNote"
          },
          "type": "array"
        },
        "orders": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowFieldOrder"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "WorkflowFieldOrder": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/WorkflowOrderTarget"
        }
      },
      "required": [
        "target",
        "fields"
      ],
      "type": "object"
    },
    "WorkflowModelErrorStrategy": {
      "description": "As Dify's error handling, for a call that failed or timed out after its\nretries. Cancellation, an unknown outcome and authority errors still stop\nthe run.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The run stops with the node's failure.",
          "properties": {
            "type": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The node succeeds with this `text` (and `structured_output`, which a\ndeclared schema requires), empty reasoning and zero usage.",
          "properties": {
            "structured_output": true,
            "text": {
              "type": "string"
            },
            "type": {
              "const": "default_value",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The node leaves through its `fail` port with `error_type` and\n`error_message`; only nodes reached through that port see them.",
          "properties": {
            "type": {
              "const": "fail_branch",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowModelMessage": {
      "additionalProperties": false,
      "description": "One prompt message of a Model node. The first message is the system\nprompt and every later one a user or assistant turn. Its content is fixed\ntext (string literals) and explicit references, rendered in order: a\nstring value as itself, any other value as its JSON text.",
      "properties": {
        "content": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowValue"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/WorkflowModelRole"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "WorkflowModelOutput": {
      "description": "The single authored output contract of a Workflow Model node.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Preserve the final model text as a string, including JSON-looking text.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Commit only the parsed, locally validated object.",
          "properties": {
            "schema": true,
            "type": {
              "const": "json_schema",
              "type": "string"
            }
          },
          "required": [
            "type",
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowModelPolicy": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max_output_tokens": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "mode": {
              "const": "explicit",
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_params": {
              "additionalProperties": true,
              "default": {},
              "type": "object"
            }
          },
          "required": [
            "mode",
            "model"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowModelRetry": {
      "additionalProperties": false,
      "description": "As Dify's retry on failure: a failed or timed-out call is made again, up\nto `max_retries` more times, `interval_ms` after the previous one ended.",
      "properties": {
        "interval_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_retries",
        "interval_ms"
      ],
      "type": "object"
    },
    "WorkflowModelRole": {
      "description": "Who speaks a Model prompt message.",
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "type": "string"
    },
    "WorkflowNodeAddress": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "items": {
            "$ref": "#/$defs/WorkflowBlockStep"
          },
          "type": "array"
        },
        "node": {
          "type": "string"
        }
      },
      "required": [
        "block",
        "node"
      ],
      "type": "object"
    },
    "WorkflowNodeDefinition": {
      "description": "One Workflow node in the authoring/domain layer.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The block's real Start node. Its input is the block input contract.",
          "properties": {
            "type": {
              "const": "start",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One tool-free logical Auxiliary Call using the invoking Attempt's authority.",
          "properties": {
            "messages": {
              "description": "The prompt: a system message, then user and assistant turns.",
              "items": {
                "$ref": "#/$defs/WorkflowModelMessage"
              },
              "type": "array"
            },
            "model": {
              "$ref": "#/$defs/WorkflowModelPolicy",
              "default": {
                "mode": "session"
              }
            },
            "on_error": {
              "$ref": "#/$defs/WorkflowModelErrorStrategy",
              "description": "What a call that still failed does."
            },
            "output": {
              "$ref": "#/$defs/WorkflowModelOutput"
            },
            "retry": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WorkflowModelRetry"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Retry a failed call before its failure is handled."
            },
            "type": {
              "const": "model",
              "type": "string"
            }
          },
          "required": [
            "type",
            "messages",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Repeat one fixed typed body until its committed result satisfies `until`.",
          "properties": {
            "body": {
              "$ref": "#/$defs/WorkflowBlock"
            },
            "carry": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "input": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "max_iterations": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "loop",
              "type": "string"
            },
            "until": {
              "$ref": "#/$defs/WorkflowPredicate"
            }
          },
          "required": [
            "type",
            "input",
            "body",
            "until",
            "carry",
            "max_iterations"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "context": {
              "items": {
                "$ref": "#/$defs/WorkflowValue"
              },
              "type": "array"
            },
            "subject": {
              "$ref": "#/$defs/WorkflowReviewSubject"
            },
            "type": {
              "const": "review",
              "type": "string"
            }
          },
          "required": [
            "type",
            "subject",
            "context"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One statically selected, explicitly admitted foreground capability.",
          "properties": {
            "arguments": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "result": {
              "$ref": "#/$defs/WorkflowToolResult"
            },
            "selector": {
              "$ref": "#/$defs/WorkflowToolSelector"
            },
            "type": {
              "const": "tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "selector",
            "arguments",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One execution of an admitted named Subagent profile.",
          "properties": {
            "output": {
              "$ref": "#/$defs/WorkflowAgentOutput",
              "description": "What the `AgentRun` returns: its final reply text, or a\nstructured value committed through `workflow_output`."
            },
            "profile": {
              "description": "The native named profile to resolve at `AgentRun` admission.",
              "type": "string"
            },
            "task": {
              "description": "The task instruction for this `AgentRun`: fixed text and explicit\nreferences, as a Model message's content.",
              "items": {
                "$ref": "#/$defs/WorkflowValue"
              },
              "type": "array"
            },
            "type": {
              "const": "agent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile",
            "task",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered IF / ELIF cases, followed by the false (ELSE) port.",
          "properties": {
            "cases": {
              "items": {
                "$ref": "#/$defs/WorkflowBranchCase"
              },
              "type": "array"
            },
            "type": {
              "const": "branch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cases"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Constructs a value and completes exactly this owning block.",
          "properties": {
            "output": {
              "$ref": "#/$defs/WorkflowValue",
              "description": "The owning block's declared result."
            },
            "type": {
              "const": "return",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowNodePresentation": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/WorkflowNodeAddress"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowDimensions"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authored Loop container geometry, never measured DOM state."
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "WorkflowNote": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "items": {
            "$ref": "#/$defs/WorkflowBlockStep"
          },
          "type": "array"
        },
        "dimensions": {
          "$ref": "#/$defs/WorkflowDimensions"
        },
        "id": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/WorkflowPosition"
        },
        "text": {
          "type": "string"
        },
        "theme": {
          "$ref": "#/$defs/WorkflowNoteTheme"
        }
      },
      "required": [
        "id",
        "block",
        "text",
        "theme",
        "position",
        "dimensions"
      ],
      "type": "object"
    },
    "WorkflowNoteTheme": {
      "enum": [
        "neutral",
        "blue",
        "green",
        "amber",
        "rose"
      ],
      "type": "string"
    },
    "WorkflowOrderTarget": {
      "description": "Presentation order targets a specific authored list. Schema `path` contains\nproperty names (not JSON pointers); missing/new fields append in key order.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "block": {
              "items": {
                "$ref": "#/$defs/WorkflowBlockStep"
              },
              "type": "array"
            },
            "kind": {
              "const": "block_input",
              "type": "string"
            },
            "path": {
              "items": {
                "$ref": "#/$defs/WorkflowSchemaStep"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "block",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "block": {
              "items": {
                "$ref": "#/$defs/WorkflowBlockStep"
              },
              "type": "array"
            },
            "kind": {
              "const": "block_output",
              "type": "string"
            },
            "path": {
              "items": {
                "$ref": "#/$defs/WorkflowSchemaStep"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "block",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "address": {
              "$ref": "#/$defs/WorkflowNodeAddress"
            },
            "kind": {
              "const": "node_output",
              "type": "string"
            },
            "path": {
              "items": {
                "$ref": "#/$defs/WorkflowSchemaStep"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "address",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowPort": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        }
      ]
    },
    "WorkflowPosition": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "WorkflowPredicate": {
      "description": "Typed predicates. Equality requires matching scalar types; no coercion.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A boolean value.",
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WorkflowValue"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Equal scalar operands of the same static type.",
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "equal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unequal scalar operands of the same static type.",
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "not_equal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "String containment, without coercion.",
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "contains",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "not_contains",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "starts_with",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "ends_with",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Whether a string is empty.",
          "properties": {
            "type": {
              "const": "empty",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WorkflowValue"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "not_empty",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WorkflowValue"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boolean negation.",
