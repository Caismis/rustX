{
  "$defs": {
    "AgentStatusExtensionDocument": {
      "additionalProperties": false,
      "description": "The authored Agent Status extension.\n\n`enabled` composes the extension in or out of the runtime as a whole;\n`time` and `background` remain the two bounded status contributors, with\nexactly the semantics they had before the migration.",
      "properties": {
        "background": {
          "$ref": "#/$defs/BackgroundStatusConfig",
          "default": {
            "enabled": true
          },
          "description": "The Background contributor configuration."
        },
        "enabled": {
          "default": false,
          "description": "Whether this composition includes the Agent Status extension at all.\n\nWith `false` the runtime composes no status engine: the Agent Loop\nemits no Agent Status and is otherwise a completely ordinary\n`ConversationRuntime`.",
          "type": "boolean"
        },
        "time": {
          "$ref": "#/$defs/TimeStatusConfig",
          "default": {
            "enabled": true
          },
          "description": "The Time contributor configuration."
        }
      },
      "type": "object"
    },
    "AllTools": {
      "enum": [
        "all"
      ],
      "type": "string"
    },
    "BackgroundStatusConfig": {
      "additionalProperties": false,
      "description": "Configuration of the bounded Background status contributor.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether Background participates in an available Agent Status opportunity.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "GoalExtensionDocument": {
      "additionalProperties": false,
      "description": "Authored opt-in Goal composition.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "NativeAgentExtensionSelection": {
      "additionalProperties": false,
      "description": "The **presence-aware** closed selection an invocation override expresses.\n\nComplete profiles and invocation selections share omission semantics:\nomitted members compose no extension. The outer invocation dimension is\npresence-aware: absent retains the named default; present replaces it.\nThis wire record preserves the invocation protocol's camelCase spelling\nand rejects explicit null members.\n\nThe record stays closed exactly like the authored document: an unknown\nextension name is rejected by `deny_unknown_fields`, so a misspelled or\nnot-yet-implemented extension fails deterministically instead of being\nsilently ignored.",
      "properties": {
        "agentStatus": {
          "$ref": "#/$defs/AgentStatusExtensionDocument",
          "description": "The requested Agent Status extension, when this selection composes it.\n\n`null` is not accepted: the field is either absent (not composed) or a\ncomplete authored configuration. Collapsing an explicit `null` into\n\"absent\" would give one wire spelling two meanings."
        },
        "goal": {
          "$ref": "#/$defs/GoalExtensionDocument"
        },
        "todo": {
          "$ref": "#/$defs/TodoExtensionDocument",
          "description": "The requested Todo extension, when this selection composes it\n(Issue #259).\n\nAbsent means the child composes no Todo at all — no list authority, no\n`todo` Tool, no status contribution — never \"whatever the role\nauthored\". `null` is refused for the same reason `agentStatus` refuses\nit: one wire spelling may not carry two meanings."
        }
      },
      "type": "object"
    },
    "SourceToolSelection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllTools"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Exactly two trust granularities for one source. This is also the authoring\nboundary: only the literal \"all\" or an exact array is accepted. `All`\ngrants source-wide Tools and negotiated Resources; `Exact` grants only\nthe named ordinary Tools and never source-wide Resources access."
    },
    "SubagentInvocationOverride": {
      "additionalProperties": false,
      "description": "One invocation-scoped replacement of selected child capability\ndimensions.\n\nThe same value is produced by model-generated `subagent` arguments and by\ntrusted static Workflow program data. The launch boundary determines\nauthority; both share this vocabulary and the `AgentProfile` resolver.",
      "properties": {
        "plugins": {
          "$ref": "#/$defs/NativeAgentExtensionSelection",
          "description": "The complete replacement Plugin composition, when this\ndimension is overridden. Absent uses the definition's composition."
        },
        "skills": {
          "description": "The complete replacement Skill selection, when this dimension is\noverridden. Absent uses the definition's selection.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tools": {
          "$ref": "#/$defs/ToolSelectionDocument",
          "description": "The complete replacement Tool selection, when this dimension is\noverridden. Absent uses the definition's selection."
        }
      },
      "type": "object"
    },
    "TimeStatusConfig": {
      "additionalProperties": false,
      "description": "Configuration of the bounded Time status contributor.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether Time participates in an available Agent Status opportunity.",
          "type": "boolean"
        },
        "timezone": {
          "description": "The optional IANA timezone used only by Time presentation. Omitting it\nrenders UTC.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TodoExtensionDocument": {
      "additionalProperties": false,
      "description": "The authored Todo extension (Issue #259).\n\nTodo is *one* capability with several faces, and `enabled` composes all\nof them together or none of them:\n\n```text\nenabled = true    conversation-owned ConversationTodoList authority\n                  the model-facing `todo` Tool\n                  the bounded read-only Todo status presentation\n                  the Runtime Client / TUI Todo projection\n\nenabled = false   none of the above for this runtime; canonical history\n                  keeps every Todo ToolCall/ToolResult it already holds\n```\n\nIt carries no contributor settings today. That is a statement about the\nextension, not a placeholder: the list's bounds, transitions, and\ndependency rules are owned by\n[`ConversationTodoList`](crate::tools::todo::ConversationTodoList) and are\nnot launch configuration.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether this composition includes the Todo extension at all.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ToolSelectionDocument": {
      "additionalProperties": false,
      "description": "Shared Agent and Workflow Agent override selection. Extensions are composed\nby their native owner and never enter this ordinary capability vocabulary.",
      "properties": {
        "builtin": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceToolSelection"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "WorkflowBlock": {
      "additionalProperties": false,
      "description": "A fixed lexical graph shared by the root and Loop bodies.",
      "properties": {
        "edges": {
          "default": [],
          "description": "Ordinary sequential control-flow edges.",
          "items": {
            "$ref": "#/$defs/WorkflowEdgeDefinition"
          },
          "type": "array"
        },
        "input": {
          "description": "The workflow input JSON Schema."
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowNodeDefinition"
          },
          "description": "Stable node definitions keyed by explicit node id.",
          "type": "object"
        },
        "output": {
          "description": "The workflow output JSON Schema."
        }
      },
      "required": [
        "input",
        "output",
        "nodes"
      ],
      "type": "object"
    },
    "WorkflowBlockStep": {
      "additionalProperties": false,
      "description": "Structured lexical address of a Loop body.",
      "properties": {
        "node": {
          "type": "string"
        }
      },
      "required": [
        "node"
      ],
      "type": "object"
    },
    "WorkflowBranchCase": {
      "additionalProperties": false,
      "description": "A stable exit identity and its condition. The first matching case wins.",
      "properties": {
        "condition": {
          "$ref": "#/$defs/WorkflowPredicate"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "condition"
      ],
      "type": "object"
    },
    "WorkflowDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "WorkflowDisplay": {
      "additionalProperties": false,
      "description": "How people see the Workflow in the library and editor. Never part of the\nprogram: models only read the definition's own `description`.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "description": "An Iconify icon name, `<prefix>:<name>` (e.g. `lucide:workflow`).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "The human name; the file id remains the native identity.",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "WorkflowEdgeDefinition": {
      "additionalProperties": false,
      "description": "One explicit edge in the workflow graph.",
      "properties": {
        "from": {
          "description": "Source node id.",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowPort"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required Branch/Loop outcome port. Ordinary nodes must omit it."
        },
        "to": {
          "description": "Destination node id.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "WorkflowEditorMetadata": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowDisplay"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowNodePresentation"
          },
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowNote"
          },
          "type": "array"
        },
        "orders": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkflowFieldOrder"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "WorkflowFieldOrder": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/WorkflowOrderTarget"
        }
      },
      "required": [
        "target",
        "fields"
      ],
      "type": "object"
    },
    "WorkflowModelOutput": {
      "description": "The single authored output contract of a Workflow Model node.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Preserve the final model text as a string, including JSON-looking text.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Commit only the parsed, locally validated object.",
          "properties": {
            "schema": true,
            "type": {
              "const": "json_schema",
              "type": "string"
            }
          },
          "required": [
            "type",
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowModelPolicy": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max_output_tokens": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "mode": {
              "const": "explicit",
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_params": {
              "additionalProperties": true,
              "default": {},
              "type": "object"
            }
          },
          "required": [
            "mode",
            "model"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowNodeAddress": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "items": {
            "$ref": "#/$defs/WorkflowBlockStep"
          },
          "type": "array"
        },
        "node": {
          "type": "string"
        }
      },
      "required": [
        "block",
        "node"
      ],
      "type": "object"
    },
    "WorkflowNodeDefinition": {
      "description": "One Workflow node in the authoring/domain layer.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The block's real Start node. Its input is the block input contract.",
          "properties": {
            "type": {
              "const": "start",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One tool-free logical Auxiliary Call using the invoking Attempt's authority.",
          "properties": {
            "input": {
              "additionalProperties": {
                "$ref": "#/$defs/WorkflowValue"
              },
              "default": {},
              "type": "object"
            },
            "instruction": {
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/WorkflowModelPolicy",
              "default": {
                "mode": "session"
              }
            },
            "output": {
              "$ref": "#/$defs/WorkflowModelOutput"
            },
            "type": {
              "const": "model",
              "type": "string"
            }
          },
          "required": [
            "type",
            "instruction",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Repeat one fixed typed body until its committed result satisfies `until`.",
          "properties": {
            "body": {
              "$ref": "#/$defs/WorkflowBlock"
            },
            "carry": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "input": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "max_iterations": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "loop",
              "type": "string"
            },
            "until": {
              "$ref": "#/$defs/WorkflowPredicate"
            }
          },
          "required": [
            "type",
            "input",
            "body",
            "until",
            "carry",
            "max_iterations"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "context": {
              "items": {
                "$ref": "#/$defs/WorkflowValue"
              },
              "type": "array"
            },
            "subject": {
              "$ref": "#/$defs/WorkflowReviewSubject"
            },
            "type": {
              "const": "review",
              "type": "string"
            }
          },
          "required": [
            "type",
            "subject",
            "context"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One statically selected, explicitly admitted foreground capability.",
          "properties": {
            "arguments": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "result": {
              "$ref": "#/$defs/WorkflowToolResult"
            },
            "selector": {
              "$ref": "#/$defs/WorkflowToolSelector"
            },
            "type": {
              "const": "tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "selector",
            "arguments",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One execution of an admitted named Subagent profile.",
          "properties": {
            "input": {
              "additionalProperties": {
                "$ref": "#/$defs/WorkflowValue"
              },
              "default": {},
              "description": "Explicit input bindings from workflow-local values.",
              "type": "object"
            },
            "output": {
              "description": "The frozen `AgentRun` output contract."
            },
            "override": {
              "$ref": "#/$defs/SubagentInvocationOverride",
              "description": "The optional invocation-scoped capability override of this node\n(Issue #258).\n\nThis is **trusted static program data**: it is part of the\ncompiled Workflow, is validated against the Workflow's own\nadmitted generation, and is not reachable from model output, node\ninput values, or task text. It may therefore legitimately replace\nthe role's defaults with capabilities the invoking main model does\nnot itself hold — never with capabilities the generation does not\nauthorize."
            },
            "profile": {
              "description": "The native named profile to resolve at `AgentRun` admission.",
              "type": "string"
            },
            "task": {
              "description": "The fixed task instruction for this `AgentRun`.",
              "type": "string"
            },
            "type": {
              "const": "agent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile",
            "task",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered IF / ELIF cases, followed by the false (ELSE) port.",
          "properties": {
            "cases": {
              "items": {
                "$ref": "#/$defs/WorkflowBranchCase"
              },
              "type": "array"
            },
            "type": {
              "const": "branch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cases"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Constructs a value and completes exactly this owning block.",
          "properties": {
            "output": {
              "$ref": "#/$defs/WorkflowValue",
              "description": "The owning block's declared result."
            },
            "type": {
              "const": "return",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowNodePresentation": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/WorkflowNodeAddress"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowDimensions"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authored Loop container geometry, never measured DOM state."
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "WorkflowNote": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "items": {
            "$ref": "#/$defs/WorkflowBlockStep"
          },
          "type": "array"
        },
        "dimensions": {
          "$ref": "#/$defs/WorkflowDimensions"
        },
        "id": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/WorkflowPosition"
        },
        "text": {
          "type": "string"
        },
        "theme": {
          "$ref": "#/$defs/WorkflowNoteTheme"
        }
      },
      "required": [
        "id",
        "block",
        "text",
        "theme",
        "position",
        "dimensions"
      ],
      "type": "object"
    },
    "WorkflowNoteTheme": {
      "enum": [
        "neutral",
        "blue",
        "green",
        "amber",
        "rose"
      ],
      "type": "string"
    },
    "WorkflowOrderTarget": {
      "description": "Presentation order targets a specific authored list. Schema `path` contains\nproperty names (not JSON pointers); missing/new fields append in key order.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "block": {
              "items": {
                "$ref": "#/$defs/WorkflowBlockStep"
              },
              "type": "array"
            },
            "kind": {
              "const": "block_input",
              "type": "string"
            },
            "path": {
              "items": {
                "$ref": "#/$defs/WorkflowSchemaStep"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "block",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "block": {
              "items": {
                "$ref": "#/$defs/WorkflowBlockStep"
              },
              "type": "array"
            },
            "kind": {
              "const": "block_output",
              "type": "string"
            },
            "path": {
              "items": {
                "$ref": "#/$defs/WorkflowSchemaStep"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "block",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "address": {
              "$ref": "#/$defs/WorkflowNodeAddress"
            },
            "kind": {
              "const": "node_output",
              "type": "string"
            },
            "path": {
              "items": {
                "$ref": "#/$defs/WorkflowSchemaStep"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "address",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "address": {
              "$ref": "#/$defs/WorkflowNodeAddress"
            },
            "kind": {
              "const": "node_input",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "address"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowPort": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        }
      ]
    },
    "WorkflowPosition": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "WorkflowPredicate": {
      "description": "Typed predicates. Equality requires matching scalar types; no coercion.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A boolean value.",
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WorkflowValue"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Equal scalar operands of the same static type.",
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "type": {
              "const": "equal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unequal scalar operands of the same static type.",
          "properties": {
            "left": {
              "$ref": "#/$defs/WorkflowValue"
            },
            "right": {
