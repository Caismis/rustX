{
  "$defs": {
    "AgentId": {
      "description": "Identifies an agent.",
      "type": "string"
    },
    "AgentProfileLayer": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/SubagentName"
          },
          "type": [
            "array"
          ]
        },
        "agents_md": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentProjectInstructionsDocument"
            }
          ]
        },
        "description": {
          "type": [
            "string"
          ]
        },
        "instructions": {
          "type": [
            "string"
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelLayer"
            }
          ]
        },
        "plugins": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginsLayer"
            }
          ]
        },
        "skills": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentSkillSelection"
            }
          ]
        },
        "tools": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolsLayer"
            }
          ]
        },
        "workflows": {
          "items": {
            "$ref": "#/$defs/WorkflowId"
          },
          "type": [
            "array"
          ]
        }
      },
      "type": "object"
    },
    "AgentProjectInstructionsDocument": {
      "additionalProperties": false,
      "description": "Project-instruction selection from admitted workspace resources.",
      "properties": {
        "files": {
          "default": [],
          "description": "Explicit agent-owned project instruction files, in deterministic\nconfigured order. Relative paths resolve against the owning\nconfiguration document's directory at launch resolution.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inherit": {
          "default": true,
          "description": "Whether the invoking generation's normal project instruction chain is\nprepended to the explicit files.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "AgentSkillSelection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllTools"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Prompt visibility within a frozen Skill catalog; never filesystem authority."
    },
    "AgentStatusExtensionDocument": {
      "additionalProperties": false,
      "description": "The authored Agent Status extension.\n\n`enabled` composes the extension in or out of the runtime as a whole;\n`time` and `background` remain the two bounded status contributors, with\nexactly the semantics they had before the migration.",
      "properties": {
        "background": {
          "$ref": "#/$defs/BackgroundStatusConfig",
          "default": {
            "enabled": true
          },
          "description": "The Background contributor configuration."
        },
        "enabled": {
          "default": false,
          "description": "Whether this composition includes the Agent Status extension at all.\n\nWith `false` the runtime composes no status engine: the Agent Loop\nemits no Agent Status and is otherwise a completely ordinary\n`ConversationRuntime`.",
          "type": "boolean"
        },
        "time": {
          "$ref": "#/$defs/TimeStatusConfig",
          "default": {
            "enabled": true
          },
          "description": "The Time contributor configuration."
        }
      },
      "type": "object"
    },
    "AllTools": {
      "enum": [
        "all"
      ],
      "type": "string"
    },
    "AppServerPolicy": {
      "additionalProperties": false,
      "properties": {
        "idle_grace_ms": {
          "default": 300000,
          "format": "uint64",
          "maximum": 86400000,
          "minimum": 1,
          "type": "integer"
        },
        "max_connections": {
          "default": 32,
          "format": "uint",
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_external_attachments": {
          "default": 64,
          "format": "uint",
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "max_resident_runtimes": {
          "default": 8,
          "format": "uint",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "shutdown_deadline_ms": {
          "default": 30000,
          "format": "uint64",
          "maximum": 3600000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ApprovalMode": {
      "description": "The runtime-wide control state for tool approval behavior.\n\n`Policy` consults each resolved Tool's\n[`ToolApprovalPolicy`](crate::tools::types::ToolApprovalPolicy).\n`FullAccess` changes only the effective approval result to `Never`; it\nnever changes availability, activation, execution ownership, concurrency,\nor tool authority.",
      "oneOf": [
        {
          "const": "policy",
          "description": "Use each Tool's configured approval policy.",
          "type": "string"
        },
        {
          "const": "full_access",
          "description": "Bypass approval prompts for eligible tool calls only.",
          "type": "string"
        }
      ]
    },
    "ApprovalPolicyDocument": {
      "description": "The configurable HITL approval policy of one Tool.",
      "oneOf": [
        {
          "const": "never",
          "description": "Execute without an approval interaction.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Require an approval interaction before execution.",
          "type": "string"
        }
      ]
    },
    "BackgroundStatusConfig": {
      "additionalProperties": false,
      "description": "Configuration of the bounded Background status contributor.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether Background participates in an available Agent Status opportunity.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "input_modalities": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "type": "array",
          "uniqueItems": true
        },
        "output_modalities": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "type": "array",
          "uniqueItems": true
        },
        "reasoning": {
          "type": "boolean"
        },
        "tool_calls": {
          "type": "boolean"
        }
      },
      "required": [
        "input_modalities",
        "output_modalities",
        "tool_calls",
        "reasoning"
      ],
      "type": "object"
    },
    "ChatMaxTokensField": {
      "description": "Which max-token field spelling a Chat Completions service accepts.\n\nThis is a real structural translation difference between\nOpenAI-compatible services, not a provider wire value: the two spellings\nare mutually exclusive and both are runtime-protected.",
      "oneOf": [
        {
          "const": "max_completion_tokens",
          "description": "The current `max_completion_tokens` field.",
          "type": "string"
        },
        {
          "const": "max_tokens",
          "description": "The legacy `max_tokens` field.",
          "type": "string"
        }
      ]
    },
    "ChatReasoningReplay": {
      "description": "Assistant-message field used to replay canonical reasoning through an\nOpenAI-compatible Chat Completions dialect.",
      "oneOf": [
        {
          "const": "reasoning",
          "description": "vLLM and `OpenRouter`'s plaintext reasoning field.",
          "type": "string"
        },
        {
          "const": "reasoning_content",
          "description": "`DeepSeek` V4, GLM, Qwen, and compatible preserved-thinking APIs.",
          "type": "string"
        },
        {
          "const": "omit",
          "description": "Do not replay historical canonical reasoning to the provider.",
          "type": "string"
        }
      ]
    },
    "ChatStreamUsage": {
      "description": "Whether a Chat Completions service supports streaming usage options.",
      "oneOf": [
        {
          "const": "supported",
          "description": "`stream_options.include_usage` is supported and requested.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The service rejects `stream_options`; the field is omitted.",
          "type": "string"
        }
      ]
    },
    "ChatToolProtocol": {
      "description": "The in-band tool protocol a Chat Completions model speaks.\n\nThis is a real protocol difference between OpenAI-compatible services,\nnot a provider wire value. Most services emit tool calls only through the\nstructured `tool_calls` field. Some model families additionally have a\n*reserved in-band* tool syntax that the serving stack is supposed to parse\nout of the generated text; when that parse fails, the reserved markup\nleaks into ordinary content or reasoning and the request terminates as if\nthe model had simply answered.\n\nDeclaring the dialect is what allows the adapter to recognize such a leak\nas malformed tool intent instead of guessing from arbitrary text. Nothing\nis ever inferred from a provider name or a base URL hostname.",
      "oneOf": [
        {
          "const": "native",
          "description": "Tool calls exist only as structured `tool_calls`. Generated text is\nnever inspected for tool-protocol markup.",
          "type": "string"
        },
        {
          "const": "qwen_xml",
          "description": "The Qwen XML tool dialect (`<tool_call>`, `<function=…>`,\n`<parameter=…>`), as served by vLLM and compatible stacks.",
          "type": "string"
        }
      ]
    },
    "Compat": {
      "additionalProperties": false,
      "properties": {
        "chat_max_tokens_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatMaxTokensField"
            }
          ]
        },
        "chat_reasoning_replay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatReasoningReplay"
            }
          ]
        },
        "chat_stream_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatStreamUsage"
            }
          ]
        },
        "chat_tool_protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatToolProtocol"
            }
          ]
        },
        "responses_storage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponsesStorageMode"
            }
          ]
        }
      },
      "type": "object"
    },
    "ConcurrencyPolicyDocument": {
      "description": "The configurable in-batch scheduling policy of one tool.",
      "oneOf": [
        {
          "const": "sequential",
          "description": "Calls within one batch run one at a time.",
          "type": "string"
        },
        {
          "const": "parallel",
          "description": "Calls within one batch may run concurrently.",
          "type": "string"
        }
      ]
    },
    "ContextLayer": {
      "additionalProperties": false,
      "properties": {
        "keep_recent_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "reserve_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "summary_output_cap": {
          "anyOf": [
            {
              "$ref": "#/$defs/SummaryOutput"
            }
          ]
        }
      },
      "type": "object"
    },
    "CredentialSource": {
      "description": "The declared source of one provider credential.\n\nThe syntax is exactly two forms and is never extended implicitly: a\nliteral string, or `$ENV_VAR`.",
      "type": "string"
    },
    "ExecutionPolicyDocument": {
      "description": "The configurable execution-ownership policy of one tool.",
      "oneOf": [
        {
          "const": "foreground_only",
          "description": "Attempt-owned execution only.",
          "type": "string"
        },
        {
          "const": "background_only",
          "description": "Conversation-owned execution only.",
          "type": "string"
        },
        {
          "const": "model_selectable",
          "description": "The model selects the execution mode per invocation.",
          "type": "string"
        }
      ]
    },
    "GoalExtensionDocument": {
      "additionalProperties": false,
      "description": "Authored opt-in Goal composition.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "IdleLiveness": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "disabled",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "milliseconds": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "const": "window",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "milliseconds"
          ],
          "type": "object"
        }
      ]
    },
    "InvocationPolicyDocument": {
      "additionalProperties": false,
      "description": "One tool invocation policy document.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalPolicyDocument",
          "default": "never",
          "description": "Human approval behavior for otherwise eligible calls."
        },
        "concurrency": {
          "$ref": "#/$defs/ConcurrencyPolicyDocument",
          "default": "sequential",
          "description": "In-batch scheduling policy."
        },
        "execution": {
          "$ref": "#/$defs/ExecutionPolicyDocument",
          "default": "foreground_only",
          "description": "Foreground/background ownership policy."
        }
      },
      "type": "object"
    },
    "Modality": {
      "description": "One semantic content modality of a model capability set.",
      "oneOf": [
        {
          "const": "text",
          "description": "Textual content.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "Image content.",
          "type": "string"
        },
        {
          "const": "file",
          "description": "File/document content.",
          "type": "string"
        }
      ]
    },
    "Model": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "compat": {
          "$ref": "#/$defs/Compat",
          "default": {}
        },
        "context_window": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "max_output_tokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/$defs/ModelProtocol"
        },
        "provider": {
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reasoning"
            }
          ]
        },
        "request_params": {
          "$ref": "#/$defs/RequestParamsToml",
          "default": {}
        }
      },
      "required": [
        "provider",
        "id",
        "protocol",
        "context_window",
        "max_output_tokens",
        "capabilities"
      ],
      "type": "object"
    },
    "ModelLayer": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelOutput"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            }
          ]
        },
        "reasoning_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningSelection"
            }
          ]
        },
        "request_params": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestParamsToml"
            }
          ]
        },
        "summary_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/SummaryAuthoring"
            }
          ]
        }
      },
      "type": "object"
    },
    "ModelOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "catalog_default",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "limit",
              "type": "string"
            },
            "tokens": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "tokens"
          ],
          "type": "object"
        }
      ]
    },
    "ModelProtocol": {
      "description": "The model interaction protocol an adapter must speak.",
      "oneOf": [
        {
          "const": "openai_chat_completions",
          "description": "`OpenAI` Chat Completions API.",
          "type": "string"
        },
        {
          "const": "openai_responses",
          "description": "`OpenAI` Responses API.",
          "type": "string"
        },
        {
          "const": "anthropic_messages",
          "description": "`Anthropic` Messages API.",
          "type": "string"
        }
      ]
    },
    "ModelRef": {
      "description": "An authored Model identity. Its spelling has no provider or wire semantics.",
      "type": "string"
    },
    "NativePolicyOverrideDocument": {
      "additionalProperties": false,
      "description": "Explicit native policy axes, resolved over that tool's product default.\nAbsence never applies the generic external-tool policy to a native tool.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalPolicyDocument",
          "description": "Tool approval override."
        },
        "concurrency": {
          "$ref": "#/$defs/ConcurrencyPolicyDocument",
          "description": "In-batch scheduling override."
        },
        "execution": {
          "$ref": "#/$defs/ExecutionPolicyDocument",
          "description": "Foreground/background ownership override."
        }
      },
      "type": "object"
    },
    "NativeToolsLayer": {
      "additionalProperties": false,
      "properties": {
        "bash": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "glob": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "grep": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "read": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        }
      },
      "type": "object"
    },
    "PluginsLayer": {
      "additionalProperties": false,
      "properties": {
        "agent_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentStatusExtensionDocument"
            }
          ]
        },
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalExtensionDocument"
            }
          ]
        },
        "todo": {
          "anyOf": [
            {
              "$ref": "#/$defs/TodoExtensionDocument"
            }
          ]
        }
      },
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "request_params": {
          "$ref": "#/$defs/RequestParamsToml",
          "default": {}
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "Provider": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "$ref": "#/$defs/CredentialSource",
          "description": "A literal credential or an explicit $`ENV_VAR` reference. Never inferred."
        },
        "base_url": {
          "type": "string"
        }
      },
      "required": [
        "base_url",
        "api_key"
      ],
      "type": "object"
    },
    "Reasoning": {
      "additionalProperties": false,
      "properties": {
        "default_profile": {
          "$ref": "#/$defs/ReasoningProfileId"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/Profile"
          },
          "type": "object"
        }
      },
      "required": [
        "default_profile",
        "profiles"
      ],
      "type": "object"
    },
    "ReasoningProfileId": {
      "description": "The identity of one reasoning profile declared by a model.\n\nThe runtime assigns no meaning to the name: `off`, `on`, `low`,\n`thinking-32k`, and `deep` are all just names whose wire behaviour is\nexactly the profile's configured `request_params`.",
      "type": "string"
    },
    "ReasoningSelection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "catalog_default",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "profile",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/ReasoningProfileId"
            }
          },
          "required": [
            "mode",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "RequestParamsToml": {
      "$defs": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "$ref": "#/$defs/RequestParamsToml/$defs/value"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/RequestParamsToml/$defs/value"
              },
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/RequestParamsToml/$defs/value"
      },
      "description": "Opaque provider-native structured TOML. Strings, integers, finite floats, booleans, arrays and tables only; no dates, times, datetimes, non-finite floats or explicit null. Protected wire keys are checked during model resolution.",
      "type": "object"
    },
    "ResponsesStorageMode": {
      "description": "How the `OpenAI` Responses protocol operates with provider storage.\n\nThis is continuation *structure*, not a wire value: Stored continues by\n`previous_response_id`, Stateless continues by preserved output items and\nrequires the encrypted-reasoning `include` value.",
      "oneOf": [
        {
          "const": "stored",
          "description": "Provider-side storage enabled (`store: true`).",
          "type": "string"
        },
        {
          "const": "stateless",
          "description": "Zero provider retention (`store: false`).",
          "type": "string"
        }
      ]
    },
    "SourceToolSelection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllTools"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Exactly two trust granularities for one source. This is also the authoring\nboundary: only the literal \"all\" or an exact array is accepted."
    },
    "SubagentName": {
      "description": "The canonical typed name of one admitted subagent definition.\n\nThe keyspace is deliberately narrow: lowercase ASCII letters, digits,\n`-`, and `_`, starting with a letter. A name is the model-facing routing\ntoken, the durable ownership identity, and the Runtime Client projection\nidentity, so an ambiguous or shell-shaped spelling is rejected at the\nconfiguration boundary rather than normalized later.",
      "type": "string"
    },
    "SubagentsLayer": {
      "additionalProperties": false,
      "properties": {
        "max_concurrent": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer"
          ]
        }
      },
      "type": "object"
    },
    "SummaryAuthoring": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max_output_tokens": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelOutput"
                }
              ]
            },
            "mode": {
              "const": "explicit",
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/ModelRef"
            },
            "reasoning_profile": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ReasoningSelection"
                }
              ]
            },
            "request_params": {
              "$ref": "#/$defs/RequestParamsToml",
              "default": {}
            }
          },
          "required": [
            "mode",
            "model"
          ],
          "type": "object"
        }
      ]
    },
    "SummaryOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "model_limit",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "limit",
              "type": "string"
            },
            "tokens": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "tokens"
          ],
          "type": "object"
        }
      ]
    },
    "TimeStatusConfig": {
      "additionalProperties": false,
      "description": "Configuration of the bounded Time status contributor.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether Time participates in an available Agent Status opportunity.",
          "type": "boolean"
        },
        "timezone": {
          "description": "The optional IANA timezone used only by Time presentation. Omitting it\nrenders UTC.",
          "type": [
            "string"
          ]
        }
      },
      "type": "object"
    },
    "TimeoutLayer": {
      "additionalProperties": false,
      "properties": {
        "response_start_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "stream_idle_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        }
      },
      "type": "object"
    },
    "TodoExtensionDocument": {
      "additionalProperties": false,
      "description": "The authored Todo extension (Issue #259).\n\nTodo is *one* capability with several faces, and `enabled` composes all\nof them together or none of them:\n\n```text\nenabled = true    conversation-owned ConversationTodoList authority\n                  the model-facing `todo` Tool\n                  the bounded read-only Todo status presentation\n                  the Runtime Client / TUI Todo projection\n\nenabled = false   none of the above for this runtime; canonical history\n                  keeps every Todo ToolCall/ToolResult it already holds\n```\n\nIt carries no contributor settings today. That is a statement about the\nextension, not a placeholder: the list's bounds, transitions, and\ndependency rules are owned by\n[`ConversationTodoList`](crate::tools::todo::ConversationTodoList) and are\nnot launch configuration.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether this composition includes the Todo extension at all.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ToolDeadlineLayer": {
      "additionalProperties": false,
      "properties": {
        "hard_deadline_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "idle_liveness_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdleLiveness"
            }
          ]
        }
      },
      "type": "object"
    },
    "ToolsLayer": {
      "additionalProperties": false,
      "properties": {
        "builtin": {
          "items": {
            "type": "string"
          },
          "type": [
            "array"
          ]
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceToolSelection"
          },
          "type": [
            "object"
          ]
        }
      },
      "type": "object"
    },
    "WorkflowId": {
      "description": "The configured workflow identity.\n\nThis is both the catalog key and the eventual model-facing Tool name. It\nis deliberately not repeated inside YAML.",
      "type": "string"
    }
  },
