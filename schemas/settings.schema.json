{
  "$defs": {
    "AgentId": {
      "description": "Identifies an agent.",
      "type": "string"
    },
    "AgentProfileLayer": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/SubagentName"
          },
          "type": [
            "array"
          ]
        },
        "agents_md": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentProjectInstructionsDocument"
            }
          ]
        },
        "description": {
          "type": [
            "string"
          ]
        },
        "extensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeAgentExtensionsDocument"
            }
          ]
        },
        "instructions": {
          "type": [
            "string"
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelLayer"
            }
          ]
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "type": [
            "array"
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "tools": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolSelectionDocument"
            }
          ]
        },
        "workflows": {
          "items": {
            "$ref": "#/$defs/WorkflowId"
          },
          "type": [
            "array"
          ]
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentWorktreeDocument"
            }
          ]
        }
      },
      "type": "object"
    },
    "AgentProjectInstructionsDocument": {
      "additionalProperties": false,
      "description": "Project-instruction selection from admitted workspace resources.",
      "properties": {
        "files": {
          "default": [],
          "description": "Explicit agent-owned project instruction files, in deterministic\nconfigured order. Relative paths resolve against the owning\nconfiguration document's directory at launch resolution.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inherit": {
          "default": true,
          "description": "Whether the invoking generation's normal project instruction chain is\nprepended to the explicit files.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "AgentStatusExtensionDocument": {
      "additionalProperties": false,
      "description": "The authored Agent Status extension.\n\n`enabled` composes the extension in or out of the runtime as a whole;\n`time` and `background` remain the two bounded status contributors, with\nexactly the semantics they had before the migration.",
      "properties": {
        "background": {
          "$ref": "#/$defs/BackgroundStatusConfig",
          "default": {
            "enabled": true
          },
          "description": "The Background contributor configuration."
        },
        "enabled": {
          "default": true,
          "description": "Whether this composition includes the Agent Status extension at all.\n\nWith `false` the runtime composes no status engine: the Agent Loop\nemits no Agent Status and is otherwise a completely ordinary\n`ConversationRuntime`.",
          "type": "boolean"
        },
        "time": {
          "$ref": "#/$defs/TimeStatusConfig",
          "default": {
            "enabled": true
          },
          "description": "The Time contributor configuration."
        }
      },
      "type": "object"
    },
    "AgentWorktreeDocument": {
      "additionalProperties": false,
      "description": "The resource representation of a named subagent's optional Git worktree\nisolation. An omitted or disabled value is the existing shared-workspace\nbehavior; there is no model-facing per-call override.\n\nIssue #188: when enabled, isolation runs the child from the committed\nparent `HEAD` snapshot. `require_clean_parent` defaults to `true`\n(strict): the parent source workspace must be clean, otherwise the child\nis rejected rather than silently dropping parent-local changes. Only an\nexplicit `\"require_clean_parent\": false` permits a dirty parent while the\nchild still receives exactly the committed snapshot.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether this named definition uses an isolated Git worktree.",
          "type": "boolean"
        },
        "require_clean_parent": {
          "default": true,
          "description": "Whether acquisition rejects a dirty parent workspace/index.\n\nThis is the one authoritative strictness switch, normalized at the\nconfiguration boundary: it defaults to `true` whenever isolation is\nenabled, and an explicit `false` is the intentional opt-out that runs\nfrom the captured committed `HEAD` while excluding dirty parent bytes.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "AllTools": {
      "enum": [
        "all"
      ],
      "type": "string"
    },
    "ApprovalMode": {
      "description": "The runtime-wide control state for tool approval behavior.\n\n`Policy` consults each resolved Tool's\n[`ToolApprovalPolicy`](crate::tools::types::ToolApprovalPolicy).\n`FullAccess` changes only the effective approval result to `Never`; it\nnever changes availability, activation, execution ownership, concurrency,\nor tool authority.",
      "oneOf": [
        {
          "const": "policy",
          "description": "Use each Tool's configured approval policy.",
          "type": "string"
        },
        {
          "const": "full_access",
          "description": "Bypass approval prompts for eligible tool calls only.",
          "type": "string"
        }
      ]
    },
    "ApprovalPolicyDocument": {
      "description": "The configurable HITL approval policy of one Tool.",
      "oneOf": [
        {
          "const": "never",
          "description": "Execute without an approval interaction.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Require an approval interaction before execution.",
          "type": "string"
        }
      ]
    },
    "BackgroundStatusConfig": {
      "additionalProperties": false,
      "description": "Configuration of the bounded Background status contributor.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether Background participates in an available Agent Status opportunity.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ConcurrencyPolicyDocument": {
      "description": "The configurable in-batch scheduling policy of one tool.",
      "oneOf": [
        {
          "const": "sequential",
          "description": "Calls within one batch run one at a time.",
          "type": "string"
        },
        {
          "const": "parallel",
          "description": "Calls within one batch may run concurrently.",
          "type": "string"
        }
      ]
    },
    "ContextLayer": {
      "additionalProperties": false,
      "properties": {
        "keep_recent_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "reserve_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "summary_output_cap": {
          "anyOf": [
            {
              "$ref": "#/$defs/SummaryOutput"
            }
          ]
        }
      },
      "type": "object"
    },
    "EnvironmentReference": {
      "description": "A validated reference, written as `$ENV_VAR` only in declared secret fields.",
      "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "ExecutionPolicyDocument": {
      "description": "The configurable execution-ownership policy of one tool.",
      "oneOf": [
        {
          "const": "foreground_only",
          "description": "Attempt-owned execution only.",
          "type": "string"
        },
        {
          "const": "background_only",
          "description": "Conversation-owned execution only.",
          "type": "string"
        },
        {
          "const": "model_selectable",
          "description": "The model selects the execution mode per invocation.",
          "type": "string"
        }
      ]
    },
    "GoalExtensionDocument": {
      "additionalProperties": false,
      "description": "Authored opt-in Goal composition.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "IdleLiveness": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "disabled",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "milliseconds": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "const": "window",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "milliseconds"
          ],
          "type": "object"
        }
      ]
    },
    "InvocationPolicyDocument": {
      "additionalProperties": false,
      "description": "One tool invocation policy document.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalPolicyDocument",
          "default": "never",
          "description": "Human approval behavior for otherwise eligible calls."
        },
        "concurrency": {
          "$ref": "#/$defs/ConcurrencyPolicyDocument",
          "default": "sequential",
          "description": "In-batch scheduling policy."
        },
        "execution": {
          "$ref": "#/$defs/ExecutionPolicyDocument",
          "default": "foreground_only",
          "description": "Foreground/background ownership policy."
        }
      },
      "type": "object"
    },
    "McpAuthoring": {
      "additionalProperties": false,
      "description": "Secret-field presence is retained even for empty tables, so project authority\ncannot be widened by replacing an authored empty table with a default map.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": [
            "string"
          ]
        },
        "cwd": {
          "type": [
            "string"
          ]
        },
        "enabled": {
          "type": [
            "boolean"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "sensitive_env": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentReference"
          },
          "type": [
            "object"
          ]
        },
        "sensitive_headers": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentReference"
          },
          "type": [
            "object"
          ]
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpTransportType"
            }
          ]
        },
        "url": {
          "type": [
            "string"
          ]
        }
      },
      "type": "object"
    },
    "McpTransportType": {
      "description": "The transport an `mcpServers` entry selects explicitly.",
      "oneOf": [
        {
          "const": "http",
          "description": "Streamable HTTP. This is the canonical spelling for a remote server.",
          "type": "string"
        },
        {
          "const": "stdio",
          "description": "A locally launched stdio server.",
          "type": "string"
        }
      ]
    },
    "ModelLayer": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelOutput"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            }
          ]
        },
        "reasoning_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningSelection"
            }
          ]
        },
        "request_params_json": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestParamsJson"
            }
          ]
        },
        "summary_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/SummaryAuthoring"
            }
          ]
        }
      },
      "type": "object"
    },
    "ModelOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "catalog_default",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "limit",
              "type": "string"
            },
            "tokens": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "tokens"
          ],
          "type": "object"
        }
      ]
    },
    "ModelRef": {
      "description": "A fully qualified catalog model reference: `provider-id/model-id`.\n\nThe first `/` separates the provider from the model. The model ID itself\nmay contain additional `/` characters, as is common for Hugging Face\nidentities such as `Qwen/Qwen3`, but no model-ID segment may be empty.\n\nThis is the explicit model-identity domain of the runtime. Concatenated\nstrings never travel through the runtime in its place: a reference either\nresolves to exactly one catalog model or it fails.",
      "type": "string"
    },
    "NativeAgentExtensionsDocument": {
      "additionalProperties": false,
      "description": "The closed authored composition surface of native Agent Extensions.\n\nEvery member is a concrete named extension in a closed record.\nUnknown extension names are rejected. Runtime TOML layers use the separate\n`snake_case` authoring boundary; resource and wire documents retain their\nown serialization contract.",
      "properties": {
        "agent_status": {
          "$ref": "#/$defs/AgentStatusExtensionDocument",
          "default": {
            "background": {
              "enabled": true
            },
            "enabled": false,
            "time": {
              "enabled": true
            }
          },
          "description": "The Agent Status extension: optional provider-independent runtime\ncontext for an already-established model step."
        },
        "goal": {
          "$ref": "#/$defs/GoalExtensionDocument",
          "default": {
            "enabled": false
          },
          "description": "Root-only persistent Goal pursuit, disabled by default."
        },
        "todo": {
          "$ref": "#/$defs/TodoExtensionDocument",
          "default": {
            "enabled": false
          },
          "description": "The Todo extension: the conversation-owned task list, its\nmodel-facing `todo` Tool, and its bounded status presentation\n(Issue #259)."
        }
      },
      "type": "object"
    },
    "NativePolicyOverrideDocument": {
      "additionalProperties": false,
      "description": "Explicit native policy axes, resolved over that tool's product default.\nAbsence never applies the generic external-tool policy to a native tool.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalPolicyDocument",
          "description": "Tool approval override."
        },
        "concurrency": {
          "$ref": "#/$defs/ConcurrencyPolicyDocument",
          "description": "In-batch scheduling override."
        },
        "execution": {
          "$ref": "#/$defs/ExecutionPolicyDocument",
          "description": "Foreground/background ownership override."
        }
      },
      "type": "object"
    },
    "NativeToolsLayer": {
      "additionalProperties": false,
      "properties": {
        "bash": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "glob": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "grep": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "read": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePolicyOverrideDocument"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReasoningProfileId": {
      "description": "The identity of one reasoning profile declared by a model.\n\nThe runtime assigns no meaning to the name: `off`, `on`, `low`,\n`thinking-32k`, and `deep` are all just names whose wire behaviour is\nexactly the profile's configured `request_params_json`.",
      "type": "string"
    },
    "ReasoningSelection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "catalog_default",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "profile",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/ReasoningProfileId"
            }
          },
          "required": [
            "mode",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "RequestParamsJson": {
      "description": "JSON text with an object at its top level. Arbitrary nested provider-native JSON is retained, including null. Protected wire keys are rejected during model resolution.",
      "type": "string"
    },
    "SourceToolSelection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllTools"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Exactly two trust granularities for one source. This is also the authoring\nboundary: only the literal \"all\" or an exact array is accepted."
    },
    "SubagentName": {
      "description": "The canonical typed name of one admitted subagent definition.\n\nThe keyspace is deliberately narrow: lowercase ASCII letters, digits,\n`-`, and `_`, starting with a letter. A name is the model-facing routing\ntoken, the durable ownership identity, and the Runtime Client projection\nidentity, so an ambiguous or shell-shaped spelling is rejected at the\nconfiguration boundary rather than normalized later.",
      "type": "string"
    },
    "SubagentsLayer": {
      "additionalProperties": false,
      "properties": {
        "max_concurrent": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "workflow": {
          "items": {
            "$ref": "#/$defs/SubagentName"
          },
          "type": [
            "array"
          ]
        }
      },
      "type": "object"
    },
    "SummaryAuthoring": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max_output_tokens": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelOutput"
                }
              ]
            },
            "mode": {
              "const": "explicit",
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/ModelRef"
            },
            "reasoning_profile": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ReasoningSelection"
                }
              ]
            },
            "request_params_json": {
              "$ref": "#/$defs/RequestParamsJson",
              "default": "{}"
            }
          },
          "required": [
            "mode",
            "model"
          ],
          "type": "object"
        }
      ]
    },
    "SummaryOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "model_limit",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "limit",
              "type": "string"
            },
            "tokens": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "tokens"
          ],
          "type": "object"
        }
      ]
    },
    "TimeStatusConfig": {
      "additionalProperties": false,
      "description": "Configuration of the bounded Time status contributor.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether Time participates in an available Agent Status opportunity.",
          "type": "boolean"
        },
        "timezone": {
          "description": "The optional IANA timezone used only by Time presentation. Omitting it\nrenders UTC.",
          "type": [
            "string"
          ]
        }
      },
      "type": "object"
    },
    "TimeoutLayer": {
      "additionalProperties": false,
      "properties": {
        "response_start_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "stream_idle_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        }
      },
      "type": "object"
    },
    "TodoExtensionDocument": {
      "additionalProperties": false,
      "description": "The authored Todo extension (Issue #259).\n\nTodo is *one* capability with several faces, and `enabled` composes all\nof them together or none of them:\n\n```text\nenabled = true    conversation-owned ConversationTodoList authority\n                  the model-facing `todo` Tool\n                  the bounded read-only Todo status presentation\n                  the Runtime Client / TUI Todo projection\n\nenabled = false   none of the above for this runtime; canonical history\n                  keeps every Todo ToolCall/ToolResult it already holds\n```\n\nIt carries no contributor settings today. That is a statement about the\nextension, not a placeholder: the list's bounds, transitions, and\ndependency rules are owned by\n[`ConversationTodoList`](crate::tools::todo::ConversationTodoList) and are\nnot launch configuration.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether this composition includes the Todo extension at all.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ToolDeadlineLayer": {
      "additionalProperties": false,
      "properties": {
        "hard_deadline_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer"
          ]
        },
        "idle_liveness_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdleLiveness"
            }
          ]
        }
      },
      "type": "object"
    },
    "ToolSelectionDocument": {
      "additionalProperties": false,
      "description": "Shared Agent and Workflow Agent override selection. Extensions are composed\nby their native owner and never enter this ordinary capability vocabulary.",
      "properties": {
        "builtin": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceToolSelection"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "WorkflowId": {
      "description": "The configured workflow identity.\n\nThis is both the catalog key and the eventual model-facing Tool name. It\nis deliberately not repeated inside YAML.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentProfileLayer"
        }
      ]
    },
    "agent_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentId"
        }
      ]
    },
    "approval_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalMode"
        }
      ]
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextLayer"
        }
      ]
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "type": [
        "object"
      ]
    },
    "mcp_servers": {
      "additionalProperties": {
        "$ref": "#/$defs/McpAuthoring"
      },
      "type": [
        "object"
      ]
    },
    "mcp_tool_policies": {
      "additionalProperties": {
        "$ref": "#/$defs/InvocationPolicyDocument"
      },
      "type": [
        "object"
      ]
    },
    "model_timeout_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeoutLayer"
        }
      ]
    },
    "models": {
      "type": [
        "string"
      ]
    },
    "native_tools": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeToolsLayer"
        }
      ]
    },
    "runtime_root": {
      "type": [
        "string"
      ]
    },
    "schema_version": {
