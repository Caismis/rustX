{
  "$defs": {
    "EnvironmentReference": {
      "description": "A validated reference, written as `$ENV_VAR` only in declared secret fields.",
      "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "McpAuthoring": {
      "additionalProperties": false,
      "description": "Secret-field presence is retained even for empty tables, so project authority\ncannot be widened by replacing an authored empty table with a default map.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": [
            "string"
          ]
        },
        "cwd": {
          "type": [
            "string"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "sensitive_env": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentReference"
          },
          "type": [
            "object"
          ]
        },
        "sensitive_headers": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentReference"
          },
          "type": [
            "object"
          ]
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpTransportType"
            }
          ]
        },
        "url": {
          "type": [
            "string"
          ]
        }
      },
      "type": "object"
    },
    "McpTransportType": {
      "description": "The transport an `mcpServers` entry selects explicitly.",
      "oneOf": [
        {
          "const": "http",
          "description": "Streamable HTTP. This is the canonical spelling for a remote server.",
          "type": "string"
        },
        {
          "const": "stdio",
          "description": "A locally launched stdio server.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The strict editor schema; discovery validates each named unit independently.",
  "properties": {
    "mcp_servers": {
      "additionalProperties": {
        "$ref": "#/$defs/McpAuthoring"
      },
      "default": {},
      "type": "object"
    }
  },
  "title": "McpDocument",
  "type": "object"
}
