{
  "$defs": {
    "EnvironmentReference": {
      "description": "A validated reference, written as `$ENV_VAR` only in declared secret fields.",
      "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "McpAuthoring": {
      "additionalProperties": false,
      "description": "Secret-field presence is retained even for empty tables, so project authority\ncannot be widened by replacing an authored empty table with a default map.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": [
            "string"
          ]
        },
        "cwd": {
          "type": [
            "string"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourcePermissionSet"
            }
          ]
        },
        "sensitive_env": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentReference"
          },
          "type": [
            "object"
          ]
        },
        "sensitive_headers": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentReference"
          },
          "type": [
            "object"
          ]
        },
        "tools": {
          "additionalProperties": {
            "$ref": "#/$defs/McpToolPermissionDocument"
          },
          "type": "object"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpTransportType"
            }
          ]
        },
        "url": {
          "type": [
            "string"
          ]
        }
      },
      "type": "object"
    },
    "McpToolPermissionDocument": {
      "additionalProperties": false,
      "description": "Exact-tool permission override authored under one MCP server.",
      "properties": {
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourcePermissionSet"
            }
          ],
          "description": "Complete three-mode permission object for this exact tool."
        }
      },
      "type": "object"
    },
    "McpTransportType": {
      "description": "The transport an `mcpServers` entry selects explicitly.",
      "oneOf": [
        {
          "const": "http",
          "description": "Streamable HTTP. This is the canonical spelling for a remote server.",
          "type": "string"
        },
        {
          "const": "stdio",
          "description": "A locally launched stdio server.",
          "type": "string"
        }
      ]
    },
    "ResourcePermissionSet": {
      "additionalProperties": false,
      "description": "Complete three-mode permission object for one resource or exact tool.\n\nAn authored object must supply all three entries. Omission of the whole\nobject inherits the winning source default or product defaults.",
      "properties": {
        "automatic": {
          "$ref": "#/$defs/ResourcePermissionValue",
          "description": "Automatic-mode override."
        },
        "full_access": {
          "$ref": "#/$defs/ResourcePermissionValue",
          "description": "Full Access-mode override."
        },
        "plan": {
          "$ref": "#/$defs/ResourcePermissionValue",
          "description": "Plan-mode override."
        }
      },
      "required": [
        "plan",
        "automatic",
        "full_access"
      ],
      "type": "object"
    },
    "ResourcePermissionValue": {
      "description": "One mode entry on a resource permission object.\n\nAutomatic model review is never a resource enum value: it is Automatic\nmode's built-in `default` behavior.",
      "oneOf": [
        {
          "const": "default",
          "description": "Delegate to the selected mode's built-in matrix behavior.",
          "type": "string"
        },
        {
          "const": "allow",
          "description": "Allow the call without ordinary approval or Auxiliary review.",
          "type": "string"
        },
        {
          "const": "ask",
          "description": "Require human approval for the exact frozen invocation.",
          "type": "string"
        },
        {
          "const": "deny",
          "description": "Hard-deny this invocation; elevation cannot override it.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The strict editor schema; discovery validates each named unit independently.",
  "properties": {
    "mcp_servers": {
      "additionalProperties": {
        "$ref": "#/$defs/McpAuthoring"
      },
      "default": {},
      "type": "object"
    }
  },
  "title": "McpDocument",
  "type": "object"
}
