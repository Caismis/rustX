{
  "name": "@rustx/web-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/provenance.ts --artifact",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "pnpm build && bash scripts/browser-tests.sh",
    "test:e2e:update": "pnpm build && bash scripts/browser-tests.sh shell.spec.ts foundation.spec.ts --update-snapshots",
    "dogfood:server": "node scripts/dogfood.ts",
    "check:provenance": "node scripts/provenance.ts && node scripts/notices.ts"
  },
  "dependencies": {
    "@shikijs/langs": "4.3.1",
    "@tanstack/react-virtual": "3.14.9",
    "clsx": "2.1.1",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "micromark-util-types": "2.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
