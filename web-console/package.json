{
  "name": "@rustx/web-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:host && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:host && vitest run",
    "build": "pnpm build:host && vite build && node scripts/provenance.ts --artifact",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "pnpm build && bash scripts/browser-tests.sh",
    "test:e2e:update": "RUSTX_SCREENSHOT_UPDATE=1 pnpm test:e2e",
    "dogfood:server": "node scripts/dogfood.ts",
    "check:provenance": "node scripts/provenance.ts && node scripts/notices.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "test:issue-420-performance": "vitest run --config vite.performance.config.ts",
    "install": "pnpm build:host",
    "build:host": "node-gyp rebuild --directory node_modules/node-pty && node-gyp rebuild --directory host/workspace-fs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@deepseek-ai/libreoffice-kit": "0.1.5",
    "@floating-ui/react-dom": "2.1.9",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@shikijs/langs": "4.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-virtual": "3.14.9",
    "@xstate/react": "6.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "dompurify": "3.4.16",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "image-size": "2.0.4",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "node-pty": "1.1.0",
    "papaparse": "5.5.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "shell-quote": "1.12.0",
    "shiki": "4.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xstate": "5.33.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "micromark-util-types": "2.0.2",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
