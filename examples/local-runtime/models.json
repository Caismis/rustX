{
  "schemaVersion": 1,
  "providers": {
    "example": {
      "baseUrl": "https://api.example.invalid/v1",
      "apiKey": "$RUSTX_EXAMPLE_API_KEY",
      "models": [
        {
          "id": "demo-model",
          "protocol": "openai_chat_completions",
          "contextWindow": 128000,
          "maxOutputTokens": 4096,
          "capabilities": {
            "inputModalities": ["text"],
            "outputModalities": ["text"],
            "toolCalls": true,
            "reasoning": true
          },
          "requestParams": {
            "temperature": 0.2
          },
          "reasoning": {
            "defaultProfile": "off",
            "profiles": {
              "off": {
                "enabled": false,
                "requestParams": {}
              },
              "on": {
                "enabled": true,
                "requestParams": {
                  "reasoning_effort": "low"
                }
              }
            }
          },
          "compat": {
            "chatMaxTokensField": "max_completion_tokens",
            "chatStreamUsage": "supported"
          }
        }
      ]
    }
  }
}
