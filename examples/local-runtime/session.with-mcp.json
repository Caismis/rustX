{
  "schemaVersion": 1,
  "conversationId": "local-runtime-example-with-mcp",
  "agentId": "default-agent",
  "model": {
    "model": "example/demo-model",
    "reasoningProfile": "off",
    "requestParams": {
      "temperature": 0.1
    },
    "maxOutputTokens": 2048,
    "summaryModel": {
      "mode": "session"
    }
  },
  "timezone": "Asia/Shanghai",
  "context": {
    "reserveTokens": 4096,
    "keepRecentTokens": 12000,
    "summaryOutputCap": 1024
  },
  "nativeTools": {
    "read": {
      "execution": "foreground_only",
      "concurrency": "parallel"
    },
    "write": {
      "execution": "foreground_only",
      "concurrency": "sequential"
    },
    "edit": {
      "execution": "foreground_only",
      "concurrency": "sequential"
    },
    "glob": {
      "execution": "foreground_only",
      "concurrency": "parallel"
    },
    "grep": {
      "execution": "foreground_only",
      "concurrency": "parallel"
    },
    "bash": {
      "execution": "model_selectable",
      "concurrency": "sequential"
    }
  },
  "mcpServers": [
    {
      "serverId": "example-stdio",
      "transport": {
        "type": "stdio",
        "program": "replace-with-real-mcp-server",
        "args": ["--stdio"],
        "cwd": ".",
        "environment": {
          "MCP_EXAMPLE_MODE": "replace-me"
        }
      },
      "policy": {
        "execution": "model_selectable",
        "concurrency": "sequential"
      }
    },
    {
      "serverId": "example-http",
      "transport": {
        "type": "streamable_http",
        "endpoint": "https://mcp.example.invalid/mcp",
        "headers": {
          "Authorization": "Bearer replace-me"
        }
      },
      "policy": {
        "execution": "foreground_only",
        "concurrency": "parallel"
      }
    }
  ],
  "environment": {
    "RUSTX_EXAMPLE_MODE": "local-runtime"
  }
}
