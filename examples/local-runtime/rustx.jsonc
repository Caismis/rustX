// rustx.jsonc — a complete, copyable local-runtime launch configuration.
//
// This file is JSONC: ordinary JSON plus comments and trailing commas.
// `models.jsonc` is the provider/model catalog; this file selects the model
// and defines the current runtime's policies and admitted resources.
{
  "schemaVersion": 5,
  "agentId": "default-agent",

  // The default model/session policy. The model catalog supplies the provider
  // endpoint, credentials reference, context window, and model defaults.
  "model": {
    "model": "example/demo-model",
    "reasoningProfile": "off",
    "requestParams": {
      "temperature": 0.1,
    },
    "maxOutputTokens": 2048,
    // Use the active Session model for summaries. Replace with an explicit
    // model block when summaries should use a cheaper/dedicated model.
    "summaryModel": {
      "mode": "session",
    },
  },

  // Current-launch HITL behavior; this is never restored from Session history.
  "approvalMode": "policy",

  // Optional Agent Status modules and their launch-scoped environment.
  "agentStatus": {
    "time": {
      "enabled": true,
      "timezone": "Asia/Tokyo",
    },
    "background": {
      "enabled": true,
    },
  },

  // Reserve part of the model window, retain recent context, and cap summary
  // output independently of the primary model output limit.
  "context": {
    "reserveTokens": 4096,
    "keepRecentTokens": 12000,
    "summaryOutputCap": 1024,
  },
  "modelTimeoutPolicy": {
    "responseStartTimeoutMs": 30000,
    "streamIdleTimeoutMs": 15000,
  },

  // Native tools have independent execution, concurrency, and approval axes.
  // `model_selectable` makes the model choose foreground/background for Bash;
  // `always` makes every Bash call require approval in policy mode.
  // `execution`, `ask_user`, and `todo` are fixed intrinsics and are therefore
  // intentionally absent from this configurable policy table.
  "nativeTools": {
    "read": {
      "execution": "foreground_only",
      "concurrency": "parallel",
    },
    "write": {
      "execution": "foreground_only",
      "concurrency": "sequential",
    },
    "edit": {
      "execution": "foreground_only",
      "concurrency": "sequential",
    },
    "glob": {
      "execution": "foreground_only",
      "concurrency": "parallel",
    },
    "grep": {
      "execution": "background_only",
      "concurrency": "parallel",
    },
    "bash": {
      "execution": "model_selectable",
      "concurrency": "sequential",
      "approval": "always",
    },
  },

  // The baseline is MCP-free. Uncomment one of these entries when an external
  // service is intentionally part of a local project. Both transport forms
  // stay inside the named server map:
  "mcpServers": {
    // "http-server": {
    //   "type": "http",
    //   "url": "https://example.invalid/mcp",
    //   "headers": {"Authorization": "Bearer YOUR_TOKEN"},
    // },
    // "stdio-server": {
    //   "type": "stdio",
    //   "command": "npx",
    //   "args": ["-y", "some-mcp-server"],
    //   "env": {"SERVICE_TOKEN": "YOUR_TOKEN"},
    //   "cwd": "workspace-relative-subdirectory",
    // },
  },

  // rustX invocation policy is separate from the transport/server definition.
  // A declared server with no entry uses foreground-only, sequential,
  // approval-never defaults. Uncomment the matching entry when adding a
  // server above.
  "mcpToolPolicies": {
    // "http-server": {
    //   "execution": "foreground_only",
    //   "concurrency": "parallel",
    //   "approval": "never",
    // },
  },

  // Optional native capabilities active in the main Agent. Fixed intrinsics
  // keep their intrinsic semantics; `subagent` exposes only `subagents.main`.
  "defaultTools": [
    "execution",
    "ask_user",
    "read",
    "write",
    "edit",
    "glob",
    "grep",
    "bash",
    "subagent",
    "todo",
  ],

  // Additional Skill roots/packages. `.agents/skills/` is the canonical
  // project layout and is discovered automatically. Skill discovery also
  // retains its existing `.rustx/skills` roots; this example does not rely on
  // them. Skills are not explicit Workflow-style registrations.
  "skills": [],

  // Project-owned Subagent definitions live under workspace/.agents/subagents.
  // Parent composition resolves and freezes their instruction sources before
  // execution; a child cannot rediscover this config or walk project ancestors.
  //
  // Optional per-definition Git isolation ("worktree"): an omitted block
  // keeps the shared workspace. "worktree": {"enabled": true} runs the child
  // from a committed Git snapshot of the parent HEAD and requires the parent
  // source workspace to be clean (uncommitted changes reject the child). Set
  // "requireCleanParent": false only to intentionally run from committed HEAD
  // while ignoring parent-local uncommitted changes — they are never copied.
  "subagents": {
    "maxConcurrent": 4,
    "definitions": {
      "navigator": {
        "description": "Read-only repository navigation and evidence gathering.",
        "instructionsFile": ".agents/subagents/navigator/instructions.md",
        "tools": {
          "builtin": ["read", "glob", "grep"],
        },
        "skills": ["review-guidance"],
        "agentsMd": {
          "inherit": true,
          "files": [".agents/subagents/navigator/AGENTS.md"],
        },
      },
      "reviewer": {
        "description": "Review one bounded request and return a concise result.",
        "instructionsFile": ".agents/subagents/reviewer/instructions.md",
        "model": "example/demo-model",
        "tools": {
          "builtin": ["read"],
        },
        "skills": ["review-guidance"],
        "agentsMd": {
          "inherit": false,
          "files": [".agents/subagents/reviewer/AGENTS.md"],
        },
      },
    },
    // Main exposure and Workflow admission are deliberately independent:
    // navigator is directly callable, while reviewer is Workflow-only.
    "main": ["navigator"],
    "workflow": ["reviewer"],
  },

  // Each id explicitly registers exactly one YAML file at
  // workspace/.agents/workflows/<id>.yaml. Directory presence alone does not
  // register a Workflow, and `main` independently controls model visibility.
  // YAML serializes a statically checked WorkflowDefinition which compiles to
  // one immutable WorkflowProgram; it is not a scripting language or an
  // expression/interpolation engine.
  "workflows": {
    "definitions": ["review_pr", "parallel_review"],
    "main": ["review_pr", "parallel_review"],
  },

  // Only this explicitly authorized environment reaches tools.
  "environment": {
    "RUSTX_EXAMPLE_MODE": "local-runtime",
  },
}
